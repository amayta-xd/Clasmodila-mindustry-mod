description:
'''
Shoots bullets at long ranges. Great if you want some extra dps.
Can be loaded with other ammo types making the bullets have effects.
'''
name: Artillery
type: ItemTurret
category: turret
buildTime: 150
health: 200
size: 2
range: 300
reload:	90
coolant: {
type: ConsumeCoolant
allowGas: true
allowLiquid: true
amount: 0.1
}
maxAmmo: 10
ammoTypes: {
quartz: {
type: BasicBulletType
damage: 35
splashDamage: 10
splashDamageRadius: 15
hitEffect: pointHit
lifetime: 100
speed: 3
ammoMultiplier: 1
reloadMultiplier: 0.85
buildingDamageMultiplier: 0.1
}
zinc: {
type: BasicBulletType
damage: 45
splashDamage: 15
splashDamageRadius: 15
hitEffect: pointHit
lifetime: 100
speed: 3
ammoMultiplier: 1
buildingDamageMultiplier: 0.1
}
}
targetAir: false
requirements: [
quartz/150
zinc/100
polycarbon/30
]
research: {
parent: cynnalloid
objectives: [
{
type: OnSector
preset: revelation
}
]
}
researchCost: [
quartz/1500
zinc/1000
polycarbon/300
]