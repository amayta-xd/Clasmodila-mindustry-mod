description:
'''
Shoots saws that pierce infinite amounts of enemies.
Can be loaded with other ammo types making the bullets have effects.
'''
name: Glainnull
type: ItemTurret
category: turret
buildTime: 300
health: 400
size: 3
range: 320
reload:	20
coolant: {
type: ConsumeCoolant
allowGas: true
allowLiquid: true
amount: 0.3
}
ammoPerShoot: 2
maxAmmo: 30
ammoTypes: {
pletorite: {
type: BasicBulletType
height: 20
width: 20
damage: 55
speed: 10
lifetime: 32
pierce: true
buildingDamageMultiplier: 0.1
ammoMultiplier: 6
}
}
targetAir: false
requirements: [
quartz/100
zinc/50
polycarbon/10
pletorite/5
]
research: {
parent: turret-2x2
objectives: [
{
type: OnSector
preset: white-debris
}
]
}
researchCost: [
quartz/1000
zinc/500
polycarbon/200
pletorite/50
]