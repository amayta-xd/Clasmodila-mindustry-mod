description:
'''
Shoots explosive bullets at enemies. Ideal for crowd control
Can be loaded with other ammo types making the bullets have effects.
'''
name: Grenade Launcher
type: ItemTurret
category: turret
buildTime: 150
health: 200
size: 2
range: 150
reload:	120
coolant: {
type: ConsumeCoolant
allowGas: true
allowLiquid: true
amount: 0.1
}
ammoPerShoot: 2
maxAmmo: 20
ammoTypes: {
quartz: {
type: BasicBulletType
damage: 10
speed: 2.5
lifetime: 60
splashDamage: 30
splashDamageRadius: 30
hitEffect: pointHit
buildingDamageMultiplier: 0.1
ammoMultiplier: 1
reloadMultiplier: 0.85
}
zinc: {
type: BasicBulletType
damage: 15
speed: 2.5
lifetime: 60
splashDamage: 35
splashDamageRadius: 30
hitEffect: pointHit
buildingDamageMultiplier: 0.1
ammoMultiplier: 1
}
}
targetAir: false
requirements: [
quartz/100
zinc/50
polycarbon/10
]
research: {
parent: cynnalloid
objectives: [
{
type: OnSector
preset: white-debris
}
]
}
researchCost: [
quartz/1000
zinc/500
polycarbon/200
]